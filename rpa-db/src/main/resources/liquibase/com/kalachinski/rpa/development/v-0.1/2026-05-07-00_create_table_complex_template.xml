<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="2026-05-07-00" author="Yury Kalachinski">
        <comment>Creating table: complex_template</comment>

        <createTable tableName="complex_template" schemaName="main">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_complex_template"/>
            </column>
            <column name="name" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_complex_template_name"/>
            </column>
            <column name="manufacturer" type="varchar(64)"/>
        </createTable>

        <addForeignKeyConstraint baseTableSchemaName="main"
                                 baseTableName="complex_template"
                                 baseColumnNames="id"
                                 constraintName="fk_complex_template_complex"
                                 referencedTableSchemaName="main"
                                 referencedTableName="complex"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
